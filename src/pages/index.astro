---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero";
import MarqueeBand from "../components/sections/MarqueeBand";
import About from "../components/sections/About";
import Work from "../components/sections/Work";
import Stack from "../components/sections/Stack";
import JourneySection from "../components/sections/JourneySection";
import Principles from "../components/sections/Principles";
import Contact from "../components/sections/Contact";
import { profile } from "../data/content";
import { getWorkItems } from "../lib/learning";

const WORK_COUNT = 4;
const work = (await getWorkItems()).slice(0, WORK_COUNT);
---

<Layout
  title="Home"
  description={`${profile.name} — ${profile.role} building scalable, secure, GRC-aligned software from Tangerang, Indonesia.`}
  withScene
>
  <Hero client:load />
  <MarqueeBand client:visible />
  <About client:visible />
  <Work client:visible items={work} />
  <Stack client:visible />
  <JourneySection client:visible />
  <Principles client:visible />
  <Contact client:visible />
</Layout>
