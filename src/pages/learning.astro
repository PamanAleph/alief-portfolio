---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/sections/PageHero";
import LearningList from "../components/sections/LearningList";
import { learningIntro, profile } from "../data/content";
import { getWorkItems } from "../lib/learning";

const items = await getWorkItems();
---

<Layout
  title="Continuous Learning"
  description={`Projects and writing from ${profile.name} — experiments, systems, and what shipping compliant software actually takes.`}
>
  <PageHero client:load kicker="01 — Projects & writing" title="Learning" sub={learningIntro.title} lede={learningIntro.lede} accent="cyan" label="Learning" />

  <section class="section section--tight" data-section="page" data-accent="cyan" data-label="Index" aria-label="Projects and writing">
    <div class="container">
      {
        items.length > 0 ? (
          <LearningList client:visible items={items} />
        ) : (
          <div class="empty">
            <h2 class="empty__title">Nothing here yet.</h2>
            <p>
              This is where projects and writing show up — backend architecture, audit-driven engineering, and what
              shipping compliant systems actually takes.
            </p>
            <a class="link-arrow" href={`mailto:${profile.email}`}>
              Ask me about it directly <span aria-hidden="true">→</span>
            </a>
          </div>
        )
      }
    </div>
  </section>
</Layout>
