---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { profile } from "../../data/content";

export async function getStaticPaths() {
  const entries = await getCollection("learning", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const dateLabel = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const [lead, ...rest] = entry.data.title.split(":");
const subtitle = rest.join(":").trim();

const entrySchema = {
  "@context": "https://schema.org",
  "@type": entry.data.type === "writing" ? "BlogPosting" : "CreativeWork",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  author: { "@type": "Person", name: profile.name },
  ...(entry.data.org ? { publisher: { "@type": "Organization", name: entry.data.org } } : {}),
};
---

<Layout title={entry.data.title} description={entry.data.description} jsonLd={entrySchema}>
  <article>
    <header class="article-hero" data-section="page" data-accent="lime" data-label="Reading">
      <div aria-hidden="true" class="page-hero__orb-wrap"><span class="orb page-hero__orb article-hero__orb"></span></div>
      <div class="container layer--content">
        <a class="link-arrow link-arrow--back" href="/learning/"><span aria-hidden="true">←</span> Continuous learning</a>
        <p class="kicker article-hero__meta">
          {entry.data.type === "project" ? "Project" : "Writing"}
          {entry.data.org && <> · {entry.data.org}</>} · {dateLabel}
        </p>
        <h1 class="article-hero__title">
          <span class="article-hero__lead">{lead?.trim()}</span>
          {subtitle && <span class="article-hero__sub">{subtitle}</span>}
        </h1>
        <p class="article-hero__desc">{entry.data.description}</p>
        {
          entry.data.tags.length > 0 && (
            <ul class="pills" aria-label="Tags">
              {entry.data.tags.map((tag) => (
                <li class="pill">{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="section section--tight" data-section="page" data-accent="lime" data-label="Reading">
      <div class:list={["container", "article", { "article--toc": sections.length > 1 }]}>
        <div class="prose">
          <Content />
        </div>
        {
          sections.length > 1 && (
            <nav class="toc" aria-label="Sections in this entry">
              <p class="kicker toc__label">On this page</p>
              <ol>
                {sections.map((s, i) => (
                  <li>
                    <a href={`#${s.slug}`} data-toc={s.slug}>
                      <span class="toc__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                      {s.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </div>
    </div>

    <aside class="article-next container" aria-label="Next steps">
      <a class="link-arrow" href="/learning/">All projects &amp; writing <span aria-hidden="true">→</span></a>
      <a class="link-arrow" href={`mailto:${profile.email}`}>Talk about this <span aria-hidden="true">→</span></a>
    </aside>
  </article>
</Layout>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc]"));
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc ?? ""))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.toggleAttribute("aria-current", a.dataset.toc === e.target.id));
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
